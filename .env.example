# ---------------------------------------------------------------------------
# Discord collection service - example configuration
# Copy to .env and fill in real values. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Discord Developer Portal -> Your App -> General Information -> Application ID
DISCORD_APPLICATION_ID=000000000000000000

# Discord Developer Portal -> Your App -> Bot -> Reset Token
# Treat this like a password. It is never logged and never returned by the API.
DISCORD_BOT_TOKEN=replace-with-your-bot-token

# Pinned Discord REST API version. Must stay on https://discord.com/api
DISCORD_API_BASE_URL=https://discord.com/api/v10

# --- Privileged intents ---------------------------------------------------
# Must match what is enabled under Bot -> Privileged Gateway Intents.
# With MESSAGE CONTENT disabled, message text arrives empty.
DISCORD_MESSAGE_CONTENT_INTENT=true
DISCORD_GUILD_MEMBERS_INTENT=false

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./discord_service.db
DATABASE_ECHO=false
# Milliseconds a writer waits for a lock before failing. Raise if you run several
# instances against one database file.
DATABASE_BUSY_TIMEOUT_MS=10000

# --- Access reconciliation ------------------------------------------------
# Hours between automatic re-checks of PENDING private-channel access requests.
ACCESS_RECHECK_HOURS=12
# A PENDING request older than this many days becomes EXPIRED.
ACCESS_REQUEST_EXPIRY_DAYS=30
# How often the worker wakes up to look for due requests (seconds).
WORKER_TICK_SECONDS=300
WORKER_BATCH_SIZE=25
ENABLE_BACKGROUND_WORKERS=true
ENABLE_GATEWAY=true
# Lock file guaranteeing a single Gateway / worker owner across processes.
WORKER_LOCK_FILE=.discord_service.worker.lock

# --- Collection -----------------------------------------------------------
# Discord caps a history page at 100.
HISTORY_PAGE_SIZE=100
HISTORY_MAX_MESSAGES=1000
# Default keyword matching when a request does not specify its own.
# substring (default) | word | exact
KEYWORD_MATCH_MODE=substring
KEYWORD_CASE_SENSITIVE=false

# --- Rate limits and retries ----------------------------------------------
DISCORD_REQUEST_TIMEOUT_SECONDS=20
DISCORD_MAX_RETRIES=3
DISCORD_RETRY_BASE_DELAY_SECONDS=0.5
DISCORD_MAX_RETRY_DELAY_SECONDS=30
DISCORD_MAX_RATE_LIMIT_WAIT_SECONDS=60
# Discord asks bots to send an identifying User-Agent.
DISCORD_USER_AGENT=DiscordCollectionService (https://example.invalid/discord-service, 1.0.0)

# --- Server ---------------------------------------------------------------
APP_NAME=discord-service
HOST=0.0.0.0
PORT=8100
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
# Comma-separated origins. Empty disables CORS entirely.
CORS_ORIGINS=
